{
  "name": "ddlc-themes",
  "displayName": "DDLC Chibi Themes",
  "description": "DDLC themes and Doki chibis for code-editor IDEs.",
  "icon": "assets/icon.jpg",
  "license": "MIT",
  "version": "1.0.5",
  "publisher": "ddlc-fan",
  "repository": {
    "type": "git",
    "url": "https://github.com/ViselBrx/DDLC-Extension.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  
  "keywords": [
    "ddlc",
    "doki doki literature club",
    "doki",
    "chibi",
    "ddlc themes",
    "dark theme",
    "anime",
    "dark"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "themes": [
      {
        "label": "DDLC - Monika Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/monika-dark-color-theme.json"
      },
      {
        "label": "DDLC - Sayori Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/sayori-dark-color-theme.json"
      },
      {
        "label": "DDLC - Natsuki Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/natsuki-dark-color-theme.json"
      },
      {
        "label": "DDLC - Yuri Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/yuri-dark-color-theme.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "ddlc.chibiView",
          "name": "DDLC: Doki Chibis"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.106.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
