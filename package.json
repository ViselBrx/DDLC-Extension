{
  "name": "ddlc-themes",
  "displayName": "DDLC Chibi Themes",
  "description": "DDLC themes, cute Literature Club product icons, and Doki chibis for code-editor IDEs.",
  "icon": "assets/icon.jpg",
  "license": "MIT", 
  "version": "1.0.18",
  "publisher": "ddlc-fan",
  "repository": {
    "type": "git",
    "url": "https://github.com/ViselBrx/DDLC-Extension.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "ddlc",
    "doki doki literature club",
    "doki",
    "chibi",
    "ddlc themes",
    "dark theme",
    "anime",
    "dark",
    "product icons",
    "icon theme"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "themes": [
      {
        "label": "DDLC - Monika Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/monika-dark-color-theme.json"
      },
      {
        "label": "DDLC - Sayori Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/sayori-dark-color-theme.json"
      },
      {
        "label": "DDLC - Natsuki Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/natsuki-dark-color-theme.json"
      },
      {
        "label": "DDLC - Yuri Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/yuri-dark-color-theme.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "ddlc-product-icons",
        "label": "DDLC Literature Club Icons",
        "path": "./producticons/ddlc-product-icon-theme.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ddlc-explorer",
          "title": "DDLC",
          "icon": "assets/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "ddlc.chibiView",
          "name": "DDLC: Doki Chibis"
        }
      ],
      "ddlc-explorer": [
        {
          "type": "webview",
          "id": "ddlc.dialogueView",
          "name": "Doki Dialogue"
        }
      ]
    },
    "commands": [
      {
        "command": "ddlc.selectDoki",
        "title": "DDLC: Change active Doki"
      },
      {
        "command": "ddlc.generateMonikaPoemPtBr",
        "title": "DDLC: Generate poem of the day — Monika (Portuguese)"
      },
      {
        "command": "ddlc.generateMonikaPoemEn",
        "title": "DDLC: Generate poem of the day — Monika (English)"
      },
      {
        "command": "ddlc.generateMonikaPoemEs",
        "title": "DDLC: Generate poem of the day — Monika (Spanish)"
      },
      {
        "command": "ddlc.generateSayoriPoemPtBr",
        "title": "DDLC: Generate poem of the day — Sayori (Portuguese)"
      },
      {
        "command": "ddlc.generateSayoriPoemEn",
        "title": "DDLC: Generate poem of the day — Sayori (English)"
      },
      {
        "command": "ddlc.generateSayoriPoemEs",
        "title": "DDLC: Generate poem of the day — Sayori (Spanish)"
      },
      {
        "command": "ddlc.generateNatsukiPoemPtBr",
        "title": "DDLC: Generate poem of the day — Natsuki (Portuguese)"
      },
      {
        "command": "ddlc.generateNatsukiPoemEn",
        "title": "DDLC: Generate poem of the day — Natsuki (English)"
      },
      {
        "command": "ddlc.generateNatsukiPoemEs",
        "title": "DDLC: Generate poem of the day — Natsuki (Spanish)"
      },
      {
        "command": "ddlc.generateYuriPoemPtBr",
        "title": "DDLC: Generate poem of the day — Yuri (Portuguese)"
      },
      {
        "command": "ddlc.generateYuriPoemEn",
        "title": "DDLC: Generate poem of the day — Yuri (English)"
      },
      {
        "command": "ddlc.generateYuriPoemEs",
        "title": "DDLC: Generate poem of the day — Yuri (Spanish)"
      }
    ],
    "configuration": {
      "title": "DDLC Extension",
      "properties": {
        "ddlc.dialogueCooldown": {
          "type": "number",
          "default": 5,
          "description": "Minimum seconds between Doki dialogue triggers."
        },
        "ddlc.idleTimeout": {
          "type": "number",
          "default": 60,
          "description": "Seconds of inactivity before the Doki triggers an idle dialogue."
        },
        "ddlc.showDialogueHistory": {
          "type": "boolean",
          "default": true,
          "description": "Show the last 3 dialogues as history below the speech bubble."
        },
        "ddlc.language": {
          "type": "string",
          "enum": [
            "en",
            "pt-br",
            "es"
          ],
          "default": "en",
          "description": "Language for Doki dialogues."
        },
        "ddlc.activeDoki": {
          "type": "string",
          "enum": [
            "theme",
            "monika",
            "sayori",
            "natsuki",
            "yuri"
          ],
          "default": "theme",
          "enumDescriptions": [
            "Follow the active DDLC color theme.",
            "Always use Monika, independently from the color theme.",
            "Always use Sayori, independently from the color theme.",
            "Always use Natsuki, independently from the color theme.",
            "Always use Yuri, independently from the color theme."
          ],
          "description": "Doki displayed in the chibi and dialogue views."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build:product-icons": "node scripts/build-product-icons.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.106.0",
    "@vscode/codicons": "^0.0.46-24",
    "svg-pathdata": "^6.0.3",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^15.0.1",
    "ttf2woff": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
